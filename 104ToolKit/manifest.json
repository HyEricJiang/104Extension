{
  "manifest_version": 3,
  "name": "104 招募工作台",
  "version": "1.2.0",
  "description": "下標籤、複製聯絡資料與匯出履歷 PDF 的雙分頁招募工作台。",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "downloads",
    "debugger",
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://vip.104.com.tw/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "104 招募工作台",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
