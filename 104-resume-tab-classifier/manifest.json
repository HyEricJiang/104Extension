{
  "manifest_version": 3,
  "name": "104 履歷分頁分類器",
  "version": "1.1.0",
  "description": "在 104 履歷搜尋頁快速將目前分頁加入指定的 Chrome 分頁群組。",
  "minimum_chrome_version": "89",
  "permissions": [
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vip.104.com.tw/search/SearchResumeMaster*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
