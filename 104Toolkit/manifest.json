{
  "manifest_version": 3,
  "name": "104 招募工作台",
  "version": "1.11.1",
  "description": "獨立保存履歷訓練分類、管理職缺群組、登錄邀約紀錄與匯出履歷與含標籤的 AI 訓練 PDF。",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "downloads",
    "debugger",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://vip.104.com.tw/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "104 招募工作台",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vip.104.com.tw/search/searchResult*"
      ],
      "js": [
        "screening-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.googleusercontent.com/userCodeAppPanel*"
      ],
      "all_frames": true,
      "js": [
        "invitation-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
